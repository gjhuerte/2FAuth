# Compose settings for docker-dev (copy to docker-dev/.env).
# Application settings (APP_KEY, APP_URL, DB_*, MAIL_* …) live in the project .env.

# Path to the project on the host (defaults to the repository root).
PROJECT_PATH=..

# Your host user, so files written by the container stay yours: `id -u` / `id -g`.
UID=1000
GID=1000

# Ports are published on localhost only. Use 0.0.0.0 to reach them from your LAN.
# Keep APP_URL in the project .env in sync (WebAuthn checks it).
APP_BIND=127.0.0.1
APP_PORT=8009

# Existing Docker network shared with MariaDB.
TWOFAUTH_PROXY_NETWORK=proxy

# Xdebug: off | debug | develop | coverage | profile | trace (combine with commas).
XDEBUG_MODE=off
