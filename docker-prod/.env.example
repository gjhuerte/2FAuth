# Compose settings for docker-prod (copy to docker-prod/.env).
# Application settings (APP_KEY, DB_*, MAIL_* …) live in the project .env.

# Image name/tag (push to your registry and set these to deploy a fixed build).
TWOFAUTH_IMAGE=2fauth
TWOFAUTH_TAG=latest

# Where the web server is published on the host. Keep 127.0.0.1 when a
# reverse proxy on the `proxy` network fronts the app.
TWOFAUTH_BIND=127.0.0.1
TWOFAUTH_HTTP_PORT=8010

# Existing Docker network shared with MariaDB and the reverse proxy.
TWOFAUTH_PROXY_NETWORK=proxy

# Resource limits for the container.
TWOFAUTH_CPUS=2.0
TWOFAUTH_MEMORY=1G

# Run `php artisan migrate --force` when the container starts (set true for
# the first start and after upgrades). Also creates the Passport personal
# access client once.
RUN_MIGRATIONS=false
